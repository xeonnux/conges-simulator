<h2 class="text-xl font-semibold mb-4">Rémunération mensuelle</h2>
<div class="overflow-x-auto" data-controller="simulation">
  <table class="w-full border-collapse border">
    <thead class="bg-gray-100">
      <tr>
        <th class="border px-4 py-2 text-left">Mois</th>
        <th class="border px-4 py-2 text-right">Salaire brut</th>
        <th class="border px-4 py-2 text-right">Congés — Intégral juin</th>
        <th class="border px-4 py-2 text-right">Congés — Par 1/12ème</th>
        <th class="border px-4 py-2 text-right">Congés — 10% + régul.</th>
      </tr>
    </thead>
    <tbody>
      <% months.each do |entry| %>
        <tr>
          <td class="border px-4 py-2"><%= I18n.l(Date.new(entry.year, entry.month, 1), format: :month_year) %></td>
          <td class="border px-4 py-2 text-right"><%= number_to_currency(entry.gross_salary, unit: "€", format: "%n %u") %></td>
          <td class="border px-4 py-2 text-right"><%= number_to_currency(entry.leave_mode_a, unit: "€", format: "%n %u") %></td>
          <td class="border px-4 py-2 text-right"><%= number_to_currency(entry.leave_mode_b, unit: "€", format: "%n %u") %></td>
          <td class="border px-4 py-2 text-right"><%= number_to_currency(entry.leave_mode_c, unit: "€", format: "%n %u") %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="bg-gray-50 font-bold">
      <tr>
        <td class="border px-4 py-2">TOTAL</td>
        <td class="border px-4 py-2 text-right"><%= number_to_currency(months.sum(&:gross_salary), unit: "€", format: "%n %u") %></td>
        <td class="border px-4 py-2 text-right"><%= number_to_currency(months.sum(&:leave_mode_a), unit: "€", format: "%n %u") %></td>
        <td class="border px-4 py-2 text-right"><%= number_to_currency(months.sum(&:leave_mode_b), unit: "€", format: "%n %u") %></td>
        <td class="border px-4 py-2 text-right"><%= number_to_currency(months.sum(&:leave_mode_c), unit: "€", format: "%n %u") %></td>
      </tr>
    </tfoot>
  </table>
</div>